<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorAccent</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/ui_text_secondary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background/Surface colors. -->
        <item name="android:windowBackground">@color/ui_background</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
</resources>